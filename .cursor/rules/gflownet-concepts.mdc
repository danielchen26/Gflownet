## Neural Network Integration

### Feature Extraction
```julia
function state_to_features(state::AbstractState)::Vector{Float32}
    features = extract_domain_features(state)
    
    # Validation requirements
    @assert !any(isnan.(features)) "Features contain NaN"
    @assert !any(isinf.(features)) "Features contain Inf"
    @assert length(features) > 0 "Empty feature vector"
    
    return Float32.(features)
end
```

### Policy Network Architecture

**Use the high-level interface** - neural networks are created automatically:

```julia
# The framework handles architecture internally
model = GFlowNet.create_gflownet(
    initial_state,
    all_actions;
    state_dim = 3,           # Input dimension (from state_to_features)
    hidden_dim = 64,         # This configures internal network architecture
    include_flow_estimator = true  # Adds flow network if needed
)
```

**Internal Architecture** (for advanced users):
- Forward policy: `state_dim → hidden_dim (ReLU) → action_dim`
- Flow estimator: `state_dim → hidden_dim (ReLU) → 1 (exp for positive flow)`
- Backward policy: Uses joint representation (source ⊕ target)

For implementation details: see `src/core/interface.jl:196`

## Training Process

### Trajectory Sampling
```julia
function sample_trajectory(model::GFlowNetModel)
    trajectory = [model.dag.initial_state]
    current_state = model.dag.initial_state
    
    while current_state ∉ model.dag.terminal_states
        # Get action probabilities from forward policy
        features = state_to_features(current_state)
        logits = model.forward_policy(features, parameters, states)
        probs = softmax(logits[valid_action_indices])
        
        # Sample action and apply transition
        action_idx = sample(Categorical(probs))
        next_state = apply_action(valid_actions[action_idx], current_state)
        
        push!(trajectory, next_state)
        current_state = next_state
    end
    
    return Trajectory(trajectory)
end
```

### Gradient Computation
```julia
function compute_loss_and_grad(model, trajectories)
    # Pre-compute all state features and transitions (avoid struct operations in loss)
    trajectory_data = preprocess_trajectories(trajectories)
    
    function loss_fn(params)
        total_loss = 0.0f0
        for traj_data in trajectory_data
            # Compute forward probabilities
            log_prob_sum = compute_trajectory_log_prob(traj_data, params)
            # Apply trajectory balance
            balance_error = log_Z + log_prob_sum - log_reward
            total_loss += balance_error^2
        end
        return total_loss
    end
    
    return Zygote.withgradient(loss_fn, model.parameters)
end
```

## Common Implementation Patterns

### Exploration Strategies
```julia
# ε-greedy exploration during training
function sample_with_exploration(model, state, ε=0.1)
    if rand() < ε
        # Random action
        return rand(get_applicable_actions(model.dag, state))
    else
        # Policy action
        return sample_action(model.forward_policy, state)
    end
end
```

### Performance Optimizations
```julia
# Action caching for O(1) lookups
action_cache[state] = [a for a in all_actions if is_applicable(a, state)]

# Flow memoization to prevent recomputation
if haskey(flow_cache, state)
    return flow_cache[state]
end
```

### Validation and Debugging
```julia
# Mathematical property checks
function validate_gflownet_properties(model, trajectories)
    # Check flow conservation
    for state in non_terminal_states
        incoming_flow = sum(flow(parent) * P_F(parent→state) for parent in parents)
        outgoing_flow = sum(flow(state) * P_F(state→child) for child in children)
        @assert abs(incoming_flow - outgoing_flow) < tolerance
    end
    
    # Check probability normalization
    for state in all_states
        probs = get_transition_probabilities(model, state)
        @assert abs(sum(probs) - 1.0) < tolerance
    end
end
```

## Domain-Specific Extensions

### Required Implementations
Each new domain (molecular design, causal discovery, etc.) must provide:

1. **State representation** with composition pattern
2. **Action definitions** for domain operations  
3. **Reward function** that captures domain objectives
4. **Feature extraction** for neural network compatibility
5. **Visualization utilities** for result interpretation

### Integration with Core Framework
```julia
# Example: Molecular design integration
struct MoleculeState <: AbstractState
    data::MoleculeData  # Composition pattern
    complete::Bool
end

function GFlowNet.reward(state::MoleculeState)
    return compute_molecular_property(state.data) + 0.01  # Ensure positive
end

function GFlowNet.state_to_features(state::MoleculeState)
    return Float32[
        length(state.data.atoms),
        length(state.data.bonds),
        state.complete ? 1.0 : 0.0,
        # ... domain-specific features
    ]
end
```
