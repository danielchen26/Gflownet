# Julia Files
*.jl.*.cov
*.jl.cov
*.jl.mem
.DS_Store
/Manifest.toml
/docs/Manifest.toml
# Same policy for every example environment. Tracking these caused exactly the
# breakage fixed in the Task 1 commit: a manifest resolved on one Julia version
# cannot be instantiated on another. Pin through [compat] instead.
examples/**/Manifest.toml

# Documentation build files
/docbuild/
/docs/build/

# IDE files
.vscode/
.idea/
.cursor/

# Temporary files
*.tmp
*.temp
*.swp
*~

# Database files
*.db
*.db-wal
*.db-shm
# Ignore data/ CONTENTS, not the directory itself: git cannot re-include a file
# whose parent directory is excluded, so `/data/` + `!/data/.gitkeep` silently
# fails. unified_server.jl:1811 (SQLite db), :1167 and :1207
# (fragment_libraries), :198/:1743 and pmo_benchmark.jl:80 (tdc_cache) all
# resolve into data/. core/database.jl:28 mkpaths the db, but the fragments
# route at :1170 has an isdir guard and silently returned an empty library when
# data/ was absent.
/data/*
!/data/.gitkeep

# TDC oracle model files (large pickles, downloaded at runtime)
oracle/
data/tdc_cache/

# Test artifacts
/test_env/
/results/

# Web visualization build artifacts
src/utils/visualization/web/dist/
src/utils/visualization/web/node_modules/

# Conda/Python environment
.CondaPkg/
__pycache__/
*.pyc

